<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
		<PackageReference Include="MSTest.TestFramework" Version="4.5.1" />

		<PackageReference Include="MSTest.Analyzers" Version="4.5.1">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference Include="coverlet.collector" Version="10.1.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TRNGScriptCompiler\TRNGScriptCompiler.csproj" />
		<ProjectReference Include="..\TRNGScriptCompiler.Cli\TRNGScriptCompiler.Cli.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Fixtures\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<LinkBase>Fixtures\</LinkBase>
		</Content>
	</ItemGroup>
</Project>
