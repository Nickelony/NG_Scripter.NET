<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- A malformed or misplaced XML doc fails the build; a missing one does not (see .editorconfig). -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1587</WarningsAsErrors>
		<Description>Byte-faithful C# port of the TRNG VB6 script compiler, for an editor or a tool to embed.</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Update="scripter_constants.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- The tests compile against the internal implementation types. -->
		<InternalsVisibleTo Include="TRNGScriptCompiler.Tests" />
	</ItemGroup>
</Project>
